{
  "manifest_version": 3,
  "name": "FlowBatch",
  "version": "1.0.0",
  "description": "Bulk Image Generator for Google Flow",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Open FlowBatch"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*"],
      "js": [
        "src/flow/flowSelectors.js",
        "src/flow/flowDetector.js",
        "src/flow/generationMonitor.js",
        "src/flow/flowAdapter.js",
        "src/content/content.js"
      ]
    }
  ]
}
